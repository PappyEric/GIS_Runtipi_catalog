{
    "services": [
        {
            "name": "lizmap-init",
            "image": "busybox",
            "command": "sh -c 'rm -f /www/lizmap/var/config/default.conf /www/lizmap/var/config/lizmapConfig.ini.php && mkdir -p /www/lizmap/var/db /www/lizmap/var/config /www/lizmap/var/log /www/lizmap/www && chown -R 1000:1000 /www/lizmap/var /www/lizmap/www && echo \"Permissions fixed, sleeping...\" && sleep infinity'",
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/var/db",
                    "containerPath": "/www/lizmap/var/db"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/config",
                    "containerPath": "/www/lizmap/var/config"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/log",
                    "containerPath": "/www/lizmap/var/log"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                }
            ]
        },
        {
            "name": "nginx",
            "image": "nginx:alpine",
            "isMain": true,
            "internalPort": "80",
            "command": "/bin/sh -c \"echo '' | base64 -d > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'\"",
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                }
            ],
            "depends_on": {
                "lizmap": {
                    "condition": "service_started"
                }
            }
        },
        {
            "name": "lizmap",
            "image": "3liz/lizmap-web-client:3.8",
            "environment": {
                "LIZMAP_QGIS_SERVER_URL": "http://qgis-server:8080/ows/",
                "LIZMAP_WMS_SERVER_URL": "http://qgis-server:8080/ows/",
                "LIZMAP_REDIS_HOST": "redis",
                "LIZMAP_HOME": "/www/lizmap"
            },
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/projects",
                    "containerPath": "/www/lizmap/project-home"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/db",
                    "containerPath": "/www/lizmap/var/db"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/config",
                    "containerPath": "/www/lizmap/var/config"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/log",
                    "containerPath": "/www/lizmap/var/log"
                }
            ],
            "depends_on": {
                "qgis-server": {
                    "condition": "service_started"
                },
                "redis": {
                    "condition": "service_started"
                },
                "lizmap-init": {
                    "condition": "service_started"
                }
            }
        },
        {
            "name": "qgis-plugin-init",
            "image": "alpine:latest",
            "command": "sh -c 'apk add --no-cache wget unzip && wget -O /tmp/plugin.zip https://github.com/3liz/qgis-lizmap-server-plugin/archive/refs/heads/master.zip && unzip /tmp/plugin.zip -d /tmp/ && mkdir -p /plugins/lizmap_server && cp -r /tmp/qgis-lizmap-server-plugin-master/* /plugins/lizmap_server/ && chmod -R 777 /plugins && echo \"Lizmap plugin manually installed\"'",
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/qgis_plugins",
                    "containerPath": "/plugins"
                }
            ]
        },
        {
            "name": "qgis-server",
            "image": "3liz/qgis-map-server:3.34",
            "environment": {
                "QGSRV_SERVER_WORKERS": "4",
                "QGIS_SERVER_LOG_LEVEL": "2",
                "QGIS_SERVER_LIZMAP_REVEAL_SETTINGS": "True",
                "QGSRV_SERVER_PLUGINPATH": "/plugins",
                "QGIS_PLUGINPATH": "/plugins",
                "QGIS_SERVER_LANDING_PAGE_PROJECT": "/io/data/landing.qgs"
            },
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/projects",
                    "containerPath": "/io/data"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/qgis_plugins",
                    "containerPath": "/plugins"
                }
            ],
            "depends_on": {
                "qgis-plugin-init": {
                    "condition": "service_completed_successfully"
                }
            }
        },
        {
            "name": "redis",
            "image": "redis:alpine"
        }
    ]
}