{
    "services": [
        {
            "name": "lizmap-init",
            "image": "busybox",
            "command": "sh -c 'mkdir -p /www/lizmap/var/db /www/lizmap/var/config /www/lizmap/var/log /www/lizmap/www && chown -R 1000:1000 /www/lizmap/var /www/lizmap/www && cp /generate_nginx_conf.sh /tmp/gen.sh && sed -i \"s/\\r$//\" /tmp/gen.sh && sh /tmp/gen.sh && echo \"Permissions fixed, sleeping...\" && sleep infinity'",
            "healthcheck": {
                "test": [
                    "CMD",
                    "test",
                    "-f",
                    "/www/lizmap/var/config/default.conf"
                ],
                "interval": "5s",
                "timeout": "5s",
                "retries": 5
            },
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/var/db",
                    "containerPath": "/www/lizmap/var/db"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/config",
                    "containerPath": "/www/lizmap/var/config"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/log",
                    "containerPath": "/www/lizmap/var/log"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                },
                {
                    "hostPath": "./scripts/generate_nginx_conf.sh",
                    "containerPath": "/generate_nginx_conf.sh"
                }
            ]
        },
        {
            "name": "nginx",
            "image": "nginx:alpine",
            "isMain": true,
            "internalPort": "80",
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/var/config",
                    "containerPath": "/etc/nginx/conf.d"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                }
            ],
            "depends_on": {
                "lizmap": {
                    "condition": "service_started"
                },
                "lizmap-init": {
                    "condition": "service_healthy"
                }
            }
        },
        {
            "name": "lizmap",
            "image": "3liz/lizmap-web-client:3.8",
            "environment": {
                "LIZMAP_QGIS_SERVER_URL": "http://qgis-server:5555/fcgi-bin/qgis_mapserv.fcgi",
                "LIZMAP_REDIS_HOST": "redis",
                "LIZMAP_HOME": "/var/www/lizmap"
            },
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/projects",
                    "containerPath": "/www/lizmap/project-home"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/db",
                    "containerPath": "/www/lizmap/var/db"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/config",
                    "containerPath": "/www/lizmap/var/config"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/log",
                    "containerPath": "/www/lizmap/var/log"
                }
            ],
            "depends_on": {
                "qgis-server": {
                    "condition": "service_started"
                },
                "redis": {
                    "condition": "service_started"
                },
                "lizmap-init": {
                    "condition": "service_started"
                }
            }
        },
        {
            "name": "qgis-server",
            "image": "qgis/qgis-server:latest",
            "environment": {
                "QGIS_SERVER_LOG_STDERR": "1",
                "QGIS_SERVER_LANDING_PAGE_PROJECT": "/data/landing.qgs"
            },
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/projects",
                    "containerPath": "/data"
                }
            ]
        },
        {
            "name": "redis",
            "image": "redis:alpine"
        }
    ]
}