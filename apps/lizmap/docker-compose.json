{
    "services": [
        {
            "name": "lizmap-init",
            "image": "alpine:latest",
            "command": "sh -c 'mkdir -p /srv/plugins /www/lizmap/var/db /www/lizmap/var/config /www/lizmap/var/log /www/lizmap/www; if [ ! -f /srv/plugins/lizmap_server/metadata.txt ]; then echo \"Installing Lizmap server plugin...\"; apk add --no-cache wget unzip; wget -q -O /tmp/plugin.zip https://github.com/3liz/qgis-lizmap-server-plugin/archive/refs/heads/master.zip; unzip -o /tmp/plugin.zip -d /tmp/; rm -rf /srv/plugins/lizmap_server; mv /tmp/qgis-lizmap-server-plugin-master /srv/plugins/lizmap_server; fi; chown -R 1000:1000 /srv/plugins /www/lizmap/var /www/lizmap/www; chmod -R 775 /srv/plugins /www/lizmap/var; echo \"Init complete, sleeping...\"; sleep infinity'",
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/var/db",
                    "containerPath": "/www/lizmap/var/db"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/config",
                    "containerPath": "/www/lizmap/var/config"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/log",
                    "containerPath": "/www/lizmap/var/log"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/plugins",
                    "containerPath": "/srv/plugins"
                }
            ]
        },
        {
            "name": "nginx",
            "image": "nginx:alpine",
            "isMain": true,
            "internalPort": "80",
            "command": "/bin/sh -c \"echo '' | base64 -d > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'\"",
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                }
            ],
            "depends_on": [
                "lizmap"
            ]
        },
        {
            "name": "lizmap",
            "image": "3liz/lizmap-web-client:3.8",
            "environment": {
                "LIZMAP_WMSSERVERURL": "http://qgis-server:8080/ows/",
                "LIZMAP_CACHERREDISHOST": "redis",
                "LIZMAP_CACHESTORAGETYPE": "redis",
                "LIZMAP_CACHEREDISDB": "1",
                "LIZMAP_HOME": "/www/lizmap",
                "LIZMAP_USER": "1000",
                "LIZMAP_GID": "1000"
            },
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/projects",
                    "containerPath": "/srv/projects"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/www",
                    "containerPath": "/www/lizmap/www"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/db",
                    "containerPath": "/www/lizmap/var/db"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/config",
                    "containerPath": "/www/lizmap/var/config"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/var/log",
                    "containerPath": "/www/lizmap/var/log"
                }
            ],
            "depends_on": [
                "qgis-server",
                "redis",
                "lizmap-init"
            ]
        },
        {
            "name": "qgis-server",
            "image": "3liz/qgis-map-server:3.34",
            "environment": {
                "QGSRV_SERVER_WORKERS": "4",
                "QGSRV_LOGGING_LEVEL": "DEBUG",
                "QGIS_SERVER_LIZMAP_REVEAL_SETTINGS": "true",
                "QGSRV_API_ENABLED_LIZMAP": "true",
                "QGSRV_SERVER_PLUGINPATH": "/srv/plugins",
                "QGIS_PLUGINPATH": "/srv/plugins",
                "QGSRV_CACHE_ROOTDIR": "/srv/projects",
                "QGSRV_USER": "1000:1000"
            },
            "volumes": [
                {
                    "hostPath": "${APP_DATA_DIR}/projects",
                    "containerPath": "/srv/projects"
                },
                {
                    "hostPath": "${APP_DATA_DIR}/plugins",
                    "containerPath": "/srv/plugins"
                }
            ],
            "depends_on": [
                "lizmap-init"
            ]
        },
        {
            "name": "redis",
            "image": "redis:alpine"
        }
    ]
}